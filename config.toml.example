# /_/   \_\____|\____|_|\_\___| |_|
#
# This is a reference config file used for Aggkit
# setup.
# The below configs are the default mandatory parameters to be used.
# ==============================================================================

L1URL = "https://xxxx/"
L2URL = "https://xxxx/"
# ------------------------------------------------------------------------------
# OP Node URL. To be used when deploying OP stack
# ------------------------------------------------------------------------------
OpNodeURL = "https://xxxx/"

AggLayerURL = "https://xxxx/"
# ------------------------------------------------------------------------------
# Aggkit Prover URL. To be used when FEP is enabled
# ------------------------------------------------------------------------------
AggchainProofURL = "https://xxxx/"

NetworkID = 1
SequencerPrivateKeyPath = "/path/to/keystore"
SequencerPrivateKeyPassword = "test"

# This values can be override directly from genesis.json
rollupCreationBlockNumber = 0
rollupManagerCreationBlockNumber = 0
genesisBlockNumber = 0

# Default database query timeout

[L1Config]
    # ------------------------------------------------------------------------------
    # URL is the L1 network url
    # ------------------------------------------------------------------------------
	URL = "{{L1URL}}"
    # ------------------------------------------------------------------------------
    # Address of the zkevm global exit root contract on L1
    # ------------------------------------------------------------------------------
	polygonZkEVMGlobalExitRootAddress = "0x0000000000000000000000000000000000000000"
    # ------------------------------------------------------------------------------
    # Address of the rollup manager contract on L1
    # ------------------------------------------------------------------------------
	polygonRollupManagerAddress = "0x0000000000000000000000000000000000000000"
    # ------------------------------------------------------------------------------
    # Address of the pol token address on L1
    # ------------------------------------------------------------------------------
	polTokenAddress = "0x0000000000000000000000000000000000000000"
    # ------------------------------------------------------------------------------
    # Address of the sovereign rollup contract on L1
    # ------------------------------------------------------------------------------
	polygonZkEVMAddress = "0x0000000000000000000000000000000000000000"
    # ------------------------------------------------------------------------------
    # Address of the bridge addr on L1
    # ------------------------------------------------------------------------------
	BridgeAddr = "0x0000000000000000000000000000000000000000"

[L2Config]
    # ------------------------------------------------------------------------------
    # Address of the sovereign global exit root proxy contract on L2
    # ------------------------------------------------------------------------------
	GlobalExitRootAddr = "0x0000000000000000000000000000000000000000"
    # ------------------------------------------------------------------------------
    # Address of the aggoracle committee. To be used when aggoracle committee is enabled
    # ------------------------------------------------------------------------------
	AggOracleCommitteeAddr = "0x0000000000000000000000000000000000000000"
    # ------------------------------------------------------------------------------
    # Address of the bridge addr on L2
    # ------------------------------------------------------------------------------
	BridgeAddr = "0x0000000000000000000000000000000000000000"


# ==============================================================================
# The below configs are the default parameters to be used.
# The user can modify it based on requirements
# ==============================================================================

# PathRWData = "/tmp/aggkit"
# RequireStorageContentCompatibility = true
# GenerateAggchainProofTimeout = "1h"
# defaultDBQueryTimeout = "60s"
# [L2RPC]
# ------------------------------------------------------------------------------
# Possible values for Mode - "basic", "op"
# ------------------------------------------------------------------------------
# 	Mode = "basic"
# 	URL = "{{L2URL}}"
# 	RetryMode = "backoff"
# 	MaxRetries = 5
# 	InitialBackoff = "2s"
# 	MaxBackoff = "10s"
# 	BackoffMultiplier = 2.0
#
# [Log]
# ------------------------------------------------------------------------------
# Possible values for Environment - "production", "development"
# ------------------------------------------------------------------------------
# Environment = "production"
# ------------------------------------------------------------------------------
# Possible values for Level - "debug", "info", "warn", "error", "panic", "fatal"
# ------------------------------------------------------------------------------
# Level = "info"
#
# [L1InfoTreeSync]
# SyncBlockChunkSize = 100
#
[AggOracle]
# ------------------------------------------------------------------------------
# How the AggOracle injects the Global Exit Roots (GER) on the L2.
# Possible values for Mode:
#   "direct"    - the GER updater (an EOA) calls the L2 GER manager directly
#   "committee" - collect signatures from the GER validators and inject the GER
#                 in a single transaction (AggOracleCommittee v2).
#                 [L2Config].AggOracleCommitteeAddr is optional: when it is not set,
#                 the contract that is the globalExitRootUpdater on the L2 is used
#   "legacy"    - DEPRECATED: it is kept in this release and it will be REMOVED in the
#                 next one. Migrate to "committee" (or to "direct").
#                 Propose the GER to the legacy AggOracleCommittee (v1) contract.
#                 Requires [L2Config].AggOracleCommitteeAddr
#   "auto"      - inspect the contract that is the globalExitRootUpdater on the L2
#                 and select one of the above (default). If it finds a legacy
#                 committee (v1) it runs in the legacy mode, with a deprecation warning
# ------------------------------------------------------------------------------
# Mode = "auto"
# ------------------------------------------------------------------------------
# DEPRECATED, use Mode instead. It will be REMOVED in the next release, together
# with the legacy mode. If true (and Mode is "auto") and
# [L2Config].AggOracleCommitteeAddr is set, it is equivalent to Mode = "legacy"
# ------------------------------------------------------------------------------
EnableAggOracleCommittee = false
# ------------------------------------------------------------------------------
# Only used when the mode is (or resolves to) "committee"
# ------------------------------------------------------------------------------
# [AggOracle.CommitteeV2]
# 	# Timeout of every request to a GER validator
# 	RequestTimeout = "5s"
# 	# Time to wait before asking the validators again if the threshold was not reached
# 	CollectRetryInterval = "5s"
# 	# How many times the signatures are collected again if the committee changes before the tx is mined
# 	MaxInjectAttempts = 3
# 	# How long a GER is kept pending while the validators don't consider it final (0 = no limit)
# 	PendingGERTimeout = "0s"
# 	# URL of the validators that have no URL registered on the contract
# 	ValidatorURLOverrides = [
# 		{Address = "0x0000000000000000000000000000000000000000", URL = "https://ger-validator.example.com"},
# 	]
# 	[AggOracle.CommitteeV2.TLS]
# 		CACertFile = ""
# 		ClientCertFile = ""
# 		ClientKeyFile = ""
	    [AggOracle.EVMSender.EthTxManager]
# ------------------------------------------------------------------------------
# PrivateKeys is private key for aggoracle keystore
# ------------------------------------------------------------------------------
				PrivateKeys = [
					{Method =  "local", Path = "/app/keystore/aggoracle.keystore", Password = "testonly"},
				]
#
# [PublicREST]
# Host = "0.0.0.0"
# Port = 5577
# MaxRequestBodyBytes = 1048576
#
# [AdminREST]
# Host = "127.0.0.1"
# Port = 5579
# MaxRequestBodyBytes = 1048576
#
[AggSender]
# ------------------------------------------------------------------------------
# Set to "AggchainProof" when enabling FEP. Possible values - "PessimisticProof", "AggchainProof", "Auto"
# ------------------------------------------------------------------------------
# Mode = "Auto"
#
# [Prometheus]
# Enabled = true
# Host = "localhost"
# Port = 9091
#
# [AggchainProofGen]
# DeveloperMode = false
# 	[AggchainProofGen.AggkitProverClient]
# 		UseTLS = false
#
# [Profiling]
# ProfilingHost = "localhost"
# ProfilingPort = 6060
# ProfilingEnabled = false
#
# [Validator]
# [Validator.ServerConfig]
# 	Host = "0.0.0.0"
# 	Port = 5578
