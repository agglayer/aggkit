# listen on
# ------------------------------------------------------------------------------
Port = "{{.aggkit_node_rest_api_port}}"

# ==============================================================================
#     _    ____  ____ ____  _____ _   _ ____  _____ ____
#    / \  / ___|/ ___/ ___|| ____| \ | |  _ \| ____|  _ \
#   / _ \| |  _| |  _\___ \|  _| |  \| | | | |  _| | |_) |
#  / ___ \ |_| | |_| |___) | |___| |\  | |_| | |___|  _ <
# /_/   \_\____|\____|____/|_____|_| \_|____/|_____|_| \_\
