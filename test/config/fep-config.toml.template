[L2GERSync]
# ------------------------------------------------------------------------------
# BlockFinality indicates which finality follows AggLayer accepted values are:
# LatestBlock, SafeBlock, PendingBlock, FinalizedBlock, EarliestBlock
# Default value is "LatestBlock"
