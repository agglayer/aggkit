# Copy to .env and adjust. docker compose reads this file automatically.

# Host path to the directory the exit_certificate tool ran in. It must contain the tool config
# (parameters.toml) and its output/ subdir. Mounted into the container at /data.
EXIT_TOOL_DIR=../exit_certificate

# Name of the exit_certificate config file inside EXIT_TOOL_DIR (resolved as /data/<name>).
EXIT_CERT_CONFIG=parameters.toml

# HTTP bind + published port for the claimer API.
CLAIMER_ADDRESS=0.0.0.0
CLAIMER_PORT=8080

# Image tag to build/run.
AGGKIT_IMAGE=aggkit:exit-certificate
